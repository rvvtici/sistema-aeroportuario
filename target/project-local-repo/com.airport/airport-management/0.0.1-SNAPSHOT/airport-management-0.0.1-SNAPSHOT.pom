<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- =========================================================
         Identificação do projeto
    ========================================================== -->
    <groupId>com.airport</groupId>
    <artifactId>airport-management</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>airport-management</name>
    <description>Sistema de Gestão Aeroportuária — PostgreSQL + Cassandra + Redis</description>

    <!-- =========================================================
         Parent Spring Boot — gerencia versões de todas as deps
    ========================================================== -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.0</version>
        <relativePath/>
    </parent>

    <!-- =========================================================
         Propriedades globais
    ========================================================== -->
    <properties>
        <java.version>17</java.version>
        <start-class>com.airport.AirportApplication</start-class>
    </properties>

    <!-- =========================================================
         Dependências
    ========================================================== -->
    <dependencies>

        <!-- ── Web / API REST ───────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <!-- Jackson (JSON) já vem incluso aqui -->
        </dependency>

        <!-- ── PostgreSQL ───────────────────────────────────── -->
        <dependency>
            <!-- ORM e repositórios JPA (@Entity, @Repository, @Transactional) -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <!-- Driver JDBC do PostgreSQL -->
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>10.17.0</version>
        </dependency>

        <!-- ── Cassandra ────────────────────────────────────── -->
        <dependency>
            <!-- Repositórios Cassandra (@Table, @PrimaryKey, CassandraRepository) -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-cassandra</artifactId>
        </dependency>

        <!-- ── Redis ────────────────────────────────────────── -->
        <dependency>
            <!-- RedisTemplate, @Cacheable, pub/sub (usa Lettuce por padrão) -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- ── Utilitários ──────────────────────────────────── -->
        <dependency>
            <!-- Validação de campos (@NotNull, @Size, @Email etc.) -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ── Testes ───────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <!-- Inclui JUnit 5, Mockito e AssertJ -->
        </dependency>

    </dependencies>

    <!-- =========================================================
         Build
    ========================================================== -->
    <build>
        <plugins>
            <plugin>
                <!-- Empacota tudo em um JAR executável (java -jar) -->
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>                
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
